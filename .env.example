# DeepSeek API Key (get one at https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional Docker / HTTP server deployment settings
# HIVE_API_TOKEN=change-me-to-a-strong-secret
# HIVE_PORT=8000
# HIVE_ALLOW_PYTHON=false

# Optional Email IMAP/SMTP integration (e.g. Gmail with an App Password)
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=your-16-char-app-password

# Optional Personal WhatsApp via WAHA sidecar (`docker compose --profile whatsapp up -d`)
# WAHA_URL=http://waha:3000
# WAHA_API_KEY=change-me-waha-key
# WAHA_SESSION=default
# WAHA_WEBHOOK_SECRET=change-me-webhook-secret


